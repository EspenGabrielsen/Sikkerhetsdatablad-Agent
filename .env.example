# --- Velg leverandør: openai | azure | deepseek ---
PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- DeepSeek ---
# Hent API-nøkkel fra https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# Tilgjengelige modeller: deepseek-chat (DeepSeek-V3) | deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat

# --- SQLite database ---
# Standard: sikkerhetsdatablad.db (kan overstyres med --db CLI-argument)
DATABASE_PATH=sikkerhetsdatablad.db
